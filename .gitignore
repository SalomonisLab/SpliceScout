# --- run data & secrets (NEVER commit) ---
# every run's config.json holds the NCBI API key; xml_cache is tens of GB
runs/

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- local / transient ---
_last_url.txt
*.log
*.part
.DS_Store
Thumbs.db

# --- large external reference DBs (AltAnalyze) — downloaded, not source ---
# Exon refs ship GZIPPED (<name>.txt.gz, ~18 MB) and are auto-decompressed on launch by ensure_refs.py;
# track the committed .gz, ignore the plain-text copy it regenerates locally.
bed_template/altanalyze/refs/**/*.txt
psi_template/altanalyze/refs/**/*.txt

# --- bulk data / models (never in git) ---
*.gguf
*.bin
*.sra
*.fastq
*.fastq.gz
*.bam
*.bam.bai
*.bed.gz
